{
  "info": {
    "name": "ms-reservas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:3011"
    },
    {
      "key": "usuarios",
      "value": "http://127.0.0.1:3001"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "idCreado",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Login (ms-usuarios)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{usuarios}}/usuarios/login",
          "host": [
            "{{usuarios}}"
          ],
          "path": [
            "usuarios",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"CAMBIAR\": \"ajuste el cuerpo al login de su ms-usuarios\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.collectionVariables.set('token', j.token);",
              "pm.test('Trae token', () => pm.expect(j.token).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 GET lista -> 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base}}/reservas",
          "host": [
            "{{base}}"
          ],
          "path": [
            "reservas"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 GET filtro ?huesped= -> 200",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base}}/reservas?huesped=Ilana Urrea",
          "host": [
            "{{base}}"
          ],
          "path": [
            "reservas"
          ],
          "query": [
            {
              "key": "huesped",
              "value": "Ilana Urrea"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código 200', () => pm.response.to.have.status(200));",
              "pm.test('Solo del huésped', () => pm.response.json().every(r => r.huesped === 'Ilana Urrea'));"
            ]
          }
        }
      ]
    },
    {
